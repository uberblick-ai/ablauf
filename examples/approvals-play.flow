fan-out v0
step "Check whether approval permits the run"

outcome "Approved" reason="A maintainer started it and the input is unchanged" destination="Start the run" tone="done"
outcome "Outside input" reason="The input has not been cleared by a maintainer" destination="Ask a maintainer" tone="stop"
outcome "Edited since" reason="The input changed after the maintainer started it" destination="Ask a maintainer" tone="stop"

# Each outcome is independent; the overview compares them without linking them.
play "Compare outcomes"
 tempo 2.4s
 step "Approved" "Approval permits this run to start."
 step "Outside input" "This input needs a maintainer's clearance."
 step "Edited since" "An edit needs a fresh start from the maintainer."
play "Approved run"
 step "Approved" "The input still matches the approval."
play "Needs clearance"
 step "Outside input" actor="Maintainer" "Clear the input before starting a run."
