flow v0
# Dependabot updates: small bumps merge on their own, majors wait for a person.

columns rework main stop

box dependabot col=main title=Dependabot "opens a pull request"
pill dependencies tone=agent
box integrator "reads the title and the diff, runs the gates"
pill needs-changes col=rework row=integrator tone=rework
box implementer col=rework "one fix round, then a review"
end merged col=main "Merged · minor or patch"

panel human col=stop row=integrator span=2 tone=stop
  pill needs-human
  strong "A person decides"

dependabot --> dependencies
dependencies --> integrator : trigger
integrator --> merged : gates green
integrator --> needs-changes tone=rework from=left.1 : a gate failed
needs-changes --> implementer tone=rework
implementer --> integrator tone=rework from=right to=left.2
integrator --> human tone=stop : major, or still failing

legend
  pill tone=done "GitHub label" sample=dependencies
  box "agent role"
  panel tone=stop "a person decides"

