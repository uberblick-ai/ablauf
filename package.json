{
  "name": "ablauf",
  "version": "0.0.0",
  "private": true,
  "description": "Text-sourced flowcharts for humans and LLMs: mermaid-subset semantics, layout outside the text, deterministic rendering.",
  "license": "MIT",
  "repository": "github:uberblick-ai/ablauf",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist",
    "docs/spec"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "acceptance": "pnpm build && node scripts/acceptance.mjs",
    "lint": "biome lint --error-on-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "^26.3.0",
    "fast-check": "^4.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
