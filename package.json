{
  "name": "@uberblick/ablauf",
  "version": "0.3.1",
  "description": "Diagrams that agents lay out as text and a renderer draws as themed SVG.",
  "keywords": ["diagram", "flowchart", "svg", "text-to-diagram", "agents"],
  "homepage": "https://ablauf.uberblick.ai",
  "bugs": "https://github.com/uberblick-ai/ablauf/issues",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./playback": {
      "types": "./dist/playback.d.ts",
      "import": "./dist/playback.js"
    },
    "./viewer": {
      "types": "./dist/viewer.d.ts",
      "import": "./dist/viewer.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/uberblick-ai/ablauf.git"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "lint": "biome lint --error-on-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "node tools/test-runner.ts",
    "test:package": "node --test --test-force-exit --test-timeout=60000 test/package.test.ts",
    "render": "node tools/render.ts",
    "check": "node tools/check.ts",
    "measure": "node tools/measure.ts",
    "size": "node tools/size-budget-command.ts",
    "playground": "node tools/playground/server.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "^26.6.5",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3"
  }
}
